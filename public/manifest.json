{
  "manifest_version": 3,
  "name": "Onchain OS Console · 非官方工具",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "A local, read-only personal console for OnchainOS data inside OKX.AI.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://okx.ai/*", "https://www.okx.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["https://okx.ai/*", "https://www.okx.ai/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://okx.ai/*", "https://www.okx.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
